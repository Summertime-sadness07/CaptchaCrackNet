class CRNN(nn.Module):
    def __init__(self, in_channels, kernel_size, pool_kernel_size, dropout, vocab_size, output_length=6, num_heads=4):
        super().__init__()
        self.output_length = output_length
        self.vocab_size = vocab_size
        self.latent_dim = 128  # ✅ Set to value divisible by num_heads
        
        self.conv1 = nn.Sequential(
            nn.Conv2d(in_channels=in_channels, out_channels=in_channels*2, kernel_size=kernel_size, padding=2),
            nn.BatchNorm2d(num_features=in_channels*2),
            nn.ReLU(inplace=False),
            nn.MaxPool2d(kernel_size=pool_kernel_size)
        )
        self.conv2 = nn.Sequential(
            nn.Conv2d(in_channels=in_channels*2, out_channels=in_channels*4, kernel_size=kernel_size, padding=2),
            nn.BatchNorm2d(num_features=in_channels*4),
            nn.ReLU(inplace=False),
            nn.MaxPool2d(kernel_size=pool_kernel_size)
        )
        self.flatten = nn.Flatten()
        self.dropout = nn.Dropout(dropout)
        self.latent_fc = nn.LazyLinear(self.latent_dim)
        
        # ✅ Multi-head attention with compatible embed_dim
        self.attention = nn.MultiheadAttention(embed_dim=self.latent_dim, num_heads=num_heads, batch_first=True)
        
        self.output_fc = nn.Linear(self.latent_dim, vocab_size)

    def forward(self, x):
        batch_size = x.size(0)
        
        conv1_out = self.conv1(x)
        conv2_out = self.conv2(conv1_out)
        flattened = self.flatten(conv2_out)
        dropped = self.dropout(flattened)
        latent = self.latent_fc(dropped)  # (batch_size, latent_dim)
        
        latent_seq = latent.unsqueeze(1).repeat(1, self.output_length, 1)  # (batch_size, output_length, latent_dim)

        attn_output, _ = self.attention(latent_seq, latent_seq, latent_seq)
        
        logits = self.output_fc(attn_output)  # (batch_size, output_length, vocab_size)
        return logits
class CaptchaCrackNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.affn=AFFN(AFFN_DEPTH).to(device)

        self.conv1=nn.Sequential(
            nn.Conv2d(in_channels=1,out_channels=32,kernel_size=5,padding=2),
            nn.ReLU(inplace=False),
            nn.MaxPool2d(kernel_size=2)
        )

        self.conv2=nn.Sequential(
                    nn.Conv2d(in_channels=32,out_channels=48,kernel_size=5,padding=2),
                    nn.ReLU(inplace=False),
                    nn.MaxPool2d(kernel_size=2)
                )

        self.conv3=nn.Sequential(
            nn.Conv2d(in_channels=48,out_channels=64,kernel_size=5,padding=2),
            nn.ReLU(inplace=False),
            nn.MaxPool2d(kernel_size=2)
        )

        self.res=nn.Conv2d(in_channels=1, out_channels=32, kernel_size=5, stride=2, padding=2)

        self.crnn = CRNN(64, CRNN_KERNEL, CRNN_POOL_KERNEL, CRNN_DROPOUT, VOCAB_SIZE, OUTPUT_LENGTH).to(device)


    def forward(self,x):
        affn_out=self.affn(x)
        res_out=self.res(x)
        conv1_out=self.conv1(affn_out)
        conv2_out=self.conv2(conv1_out+res_out)
        conv3_out=self.conv3(conv2_out)
        output=self.crnn(conv3_out)
        return output
